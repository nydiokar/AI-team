# Copy outside the repository, chmod 600, and set CONTROLLER_ENV_FILE to it.
MESH_ENABLED=true
MESH_EMBEDDED_SERVER=false
MESH_BIND_HOST=0.0.0.0
MESH_TASK_SERVER_PORT=9002
MESH_DB_PATH=state/mesh.db
CONTROL_API_ENABLED=true
CONTROL_API_BIND_HOST=0.0.0.0
DASHBOARD_PORT=9003
GATEWAY_LOCAL_EXECUTION_ENABLED=false
CLAUDE_BASE_CWD=/workspaces
CLAUDE_ALLOWED_ROOT=/workspaces
WORKER_TOKEN=REPLACE_WITH_openssl_rand_hex_32
DASHBOARD_TOKEN=REPLACE_WITH_A_DIFFERENT_SECRET
