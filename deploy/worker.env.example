# Copy outside the repository, chmod 600, and set WORKER_ENV_FILE to it.
WORKER_NODE_ID=worker-1
WORKER_TOKEN=REPLACE_WITH_THE_CONTROLLER_WORKER_TOKEN
WORKER_TAILSCALE_IP=REPLACE_WITH_THIS_MACHINE_TAILSCALE_IP
CONTROLLER_URL=http://REPLACE_WITH_CONTROLLER_TAILSCALE_IP:9002
WORKER_API_PORT=9001
WORKER_BACKENDS=claude,codex
WORKER_MAX_CONCURRENT=2
# These must be the same absolute path as WORKSPACE_ROOT exported to Compose.
WORKER_PROJECTS_ROOT=/srv/worker-projects
CLAUDE_BASE_CWD=/srv/worker-projects
CLAUDE_ALLOWED_ROOT=/srv/worker-projects
# Claude authentication belongs in this role file. Codex authentication is
# bootstrapped with `codex login --device-auth` into the persistent CODEX_HOME
# volume, never copied from the host or baked into the image.
